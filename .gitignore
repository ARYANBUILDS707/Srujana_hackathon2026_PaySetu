# PaySetu repository ignores (AGENTS.md Section 13). frontend/.gitignore adds Next.js specifics.

# Secrets and local configuration: example files are committed, real values never are
.env
.env.*
!.env.example

# Runtime data: evidence, packs, outbox and databases (ARCHITECTURE.md Section 6).
# Anchored to the runtime folders only: an unanchored `storage/` also matched the source
# package backend/app/storage/, which was therefore never committed.
/storage/
/backend/storage/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
.next-e2e/
out/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/

# OS and editor files
.DS_Store
.vscode/
.idea/
