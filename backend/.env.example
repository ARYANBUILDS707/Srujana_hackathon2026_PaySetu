# PaySetu backend configuration (ARCHITECTURE.md Section 12).
# Copy to backend/.env and fill in locally. Never commit real values.
# Phase 0 reads none of these; typed settings arrive in Phase 1 (T1.1).

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=sqlite:///./storage/paysetu.db
STORAGE_DIR=./storage
TOKEN_HASH_KEY=replace-with-32-plus-random-bytes

SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30
MAX_UPLOAD_MB=15
MAX_CASE_STORAGE_MB=200

EMAIL_MODE=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=

VERIFICATION_MODE=off
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=

ALLOW_NONLIVE_VERIFIED=0
LOG_LEVEL=INFO
