# PaySetu backend configuration (ARCHITECTURE.md Section 12).
# Copy to backend/.env and fill in locally. Never commit real values.
# Validated at startup by app/config.py (T1.1); an invalid value stops the server with a
# message naming the variable. Required: APP_ENV, PUBLIC_BASE_URL, DATABASE_URL,
# STORAGE_DIR, TOKEN_HASH_KEY, EMAIL_MODE.

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=sqlite:///./storage/paysetu.db
STORAGE_DIR=./storage
# At least 32 bytes. The example value works locally but is rejected in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_HASH_KEY=replace-with-32-plus-random-bytes

SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30
MAX_UPLOAD_MB=15
MAX_CASE_STORAGE_MB=200

EMAIL_MODE=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=

VERIFICATION_MODE=off
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=

ALLOW_NONLIVE_VERIFIED=0
LOG_LEVEL=INFO
