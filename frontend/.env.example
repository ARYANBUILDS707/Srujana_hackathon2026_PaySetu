# PaySetu frontend configuration (ARCHITECTURE.md Section 12).
# Copy to frontend/.env.local if you need to override defaults. Never put secrets here:
# the frontend needs none, and nothing may use the NEXT_PUBLIC_ prefix for secrets.

# Server-side only: target of the development /api/* rewrite. Defaults to http://localhost:8000 in development.
API_ORIGIN=http://localhost:8000
